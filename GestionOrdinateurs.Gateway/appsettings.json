{
  "ReverseProxy": {
    "Routes": {
      "ordinateurs": {
        "ClusterId": "gestionOrdinateurs",
        "Match": {
          "Path": "/api/ordinateurs/{**catch-all}"
        }
      },
      "reparations": {
        "ClusterId": "gestionOrdinateurs",
        "Match": {
          "Path": "/api/reparations/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "gestionOrdinateurs": {
        "Destinations": {
          "api": {
            "Address": "http://localhost:5100/"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
