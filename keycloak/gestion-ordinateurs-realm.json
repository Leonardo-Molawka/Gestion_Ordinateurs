{
  "realm": "gestion-ordinateurs",
  "enabled": true,
  "displayName": "Gestion des ordinateurs",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "Admin",
        "description": "Peut administrer le parc informatique"
      },
      {
        "name": "Gestionnaire",
        "description": "Peut consulter le parc informatique"
      }
    ]
  },
  "clientScopes": [
    {
      "name": "api-access",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "Audience gestionordinateurs-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "gestionordinateurs-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "Realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "gestionordinateurs-api",
      "name": "GestionOrdinateurs API",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "gestion-ordinateurs-client",
      "name": "GestionOrdinateurs Blazor",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:5000/authentication/login-callback"
      ],
      "webOrigins": [
        "http://localhost:5000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5000/authentication/logout-callback"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "api-access"
      ],
      "optionalClientScopes": [
        "email"
      ]
    }
  ]
}
